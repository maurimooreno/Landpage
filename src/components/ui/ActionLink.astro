---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}
const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['action-link', `action-link--${variant}`]} href={href}>
  <slot />
  <svg aria-hidden="true" viewBox="0 0 24 12" width="24" height="12">
    <path d="M1 6h20M16 1l5 5-5 5" />
  </svg>
</a>
<style>
  .action-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 1px solid var(--color-ink);
    padding: 0.7rem 0.9rem;
    font-family: var(--font-display);
    font-weight: 680;
    text-decoration: none;
    transition:
      color 180ms ease,
      background 180ms ease,
      translate 180ms var(--ease-out-expo);
  }
  .action-link:hover {
    translate: 0 -2px;
  }
  .action-link--primary {
    background: var(--color-ink);
    color: #fff;
  }
  .action-link--primary:hover {
    background: var(--color-plan-dark);
  }
  .action-link--secondary {
    border-color: var(--color-rule);
    color: var(--color-ink);
  }
  .action-link--secondary:hover {
    border-color: var(--color-ink);
    background: rgb(255 255 255 / 0.42);
  }
  svg {
    flex: 0 0 auto;
    fill: none;
    stroke: var(--color-mark);
    stroke-linecap: square;
    stroke-width: 1.75;
  }
</style>
