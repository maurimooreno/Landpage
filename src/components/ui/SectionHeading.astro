---
interface Props {
  title: string;
  description?: string;
  align?: 'start' | 'wide';
}
const { title, description, align = 'start' } = Astro.props;
---

<header class:list={['section-heading', align === 'wide' && 'section-heading--wide']}>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>
<style>
  .section-heading {
    display: grid;
    gap: 1.1rem;
    max-width: 55rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }
  .section-heading--wide {
    max-width: 78rem;
  }
  h2 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.2vw, 5.3rem);
    font-weight: 590;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }
  p {
    max-width: 64ch;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: clamp(1.05rem, 1.2vw, 1.28rem);
  }
</style>
