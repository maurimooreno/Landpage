---
import { services } from '../../data/services';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="servicios" class="section-frame" aria-labelledby="services-title">
  <div class="shell">
    <SectionHeading
      title="El problema primero. La tecnología después."
      description="Trabajo sobre procesos donde la información se corta, el equipo repite tareas o una herramienta existente ya no acompaña la operación."
      align="wide"
    />
    <div class="service-table">
      <div class="table-head" aria-hidden="true">
        <span>Situación</span>
        <span>Intervención</span>
        <span>Cambio esperado</span>
      </div>
      {services.map((service) => (
        <article>
          <div class="service-title">
            <span class="technical-label">{service.code}</span>
            <h3>{service.title}</h3>
            <p>{service.problem}</p>
          </div>
          <p>{service.intervention}</p>
          <p class="outcome">{service.outcome}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .table-head,
  article {
    display: grid;
    grid-template-columns: 1.15fr 1fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 5rem);
  }
  .table-head {
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 0.7rem;
    color: var(--color-ink-muted);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 650;
    text-transform: uppercase;
  }
  article {
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1.8rem, 4vw, 3.5rem);
  }
  h3 {
    max-width: 22ch;
    margin: 0.45rem 0 0.8rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.2vw, 2.2rem);
    font-weight: 610;
    line-height: 1.1;
  }
  p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink-muted);
  }
  .outcome {
    color: var(--color-plan-dark);
    font-weight: 630;
  }
  @media (max-width: 47.99rem) {
    .table-head {
      display: none;
    }
    article {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .outcome {
      border-top: 1px dashed var(--color-rule);
      padding-top: 1rem;
    }
  }
</style>
